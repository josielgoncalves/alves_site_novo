---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE, wa } from '../lib/site';

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  imageSize?: [number, number];
  canonical?: string;
  noindex?: boolean;
  type?: 'website' | 'article' | 'product';
  schema?: object | object[];
  heroDark?: boolean;
  preloadImage?: string;
}
const { title, description, image, imageAlt, imageSize, noindex = false, schema, heroDark = false, preloadImage } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '';
const canonical = Astro.props.canonical ?? SITE.url + path;
const ogImage = image ?? SITE.url + '/og-image.jpg';

const org = {
  '@context': 'https://schema.org',
  '@type': 'RealEstateAgent',
  '@id': SITE.url + '/#org',
  name: SITE.name,
  url: SITE.url,
  logo: SITE.url + '/apple-touch-icon.png',
  image: ogImage,
  telephone: '+' + SITE.phoneIntl,
  email: SITE.email,
  priceRange: '$$',
  areaServed: ['Rolante', 'Riozinho', 'Taquara', 'Santo Antônio da Patrulha', 'Sapiranga', 'Campo Bom', 'São Leopoldo'].map((n) => ({ '@type': 'City', name: n })),
  address: { '@type': 'PostalAddress', addressLocality: 'Rolante', addressRegion: 'RS', addressCountry: 'BR' },
  sameAs: [SITE.instagram],
  openingHoursSpecification: [
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'], opens: '09:00', closes: '18:00' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Saturday', opens: '09:00', closes: '13:00' },
  ],
};
const website = { '@context': 'https://schema.org', '@type': 'WebSite', url: SITE.url, name: SITE.name, inLanguage: 'pt-BR' };
const schemas = [org, website, ...(schema ? (Array.isArray(schema) ? schema : [schema]) : [])];
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1'} />
    <meta name="theme-color" content="#0f2a17" />
    <meta name="geo.region" content="BR-RS" />
    <meta name="geo.placename" content="Rolante" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://api.alvesnegociosimob.com.br" crossorigin />
    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={Astro.props.type === 'article' ? 'article' : 'website'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    {imageSize && <meta property="og:image:type" content="image/jpeg" />}
    {imageSize && <meta property="og:image:width" content={String(imageSize[0])} />}
    {imageSize && <meta property="og:image:height" content={String(imageSize[1])} />}
    <meta property="og:image:alt" content={imageAlt ?? title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
    <script is:inline>document.documentElement.classList.add('js')</script>
    <!-- Google Analytics: carrega após interação/idle para não pesar no LCP -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments)}
      gtag('js', new Date()); gtag('config', 'G-8PEQRLSG0Z');
      (function(){var l=false;function go(){if(l)return;l=true;var s=document.createElement('script');s.async=true;s.src='https://www.googletagmanager.com/gtag/js?id=G-8PEQRLSG0Z';document.head.appendChild(s)}
      ['scroll','pointerdown','keydown'].forEach(function(e){addEventListener(e,go,{once:true,passive:true})});setTimeout(go,4000)})();
    </script>
  </head>
  <body class="min-h-dvh flex flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-3 focus:top-3 focus:z-[100] focus:rounded focus:bg-white focus:px-4 focus:py-2">Pular para o conteúdo</a>
    <Header overHero={heroDark} />
    <main id="main" class="flex-1"><slot /></main>
    <Footer />
    <a href={wa('Olá! Vim pelo site e gostaria de falar sobre imóveis.')} target="_blank" rel="noopener" aria-label="Falar no WhatsApp" class="fixed bottom-4 right-4 z-40 grid h-14 w-14 place-items-center rounded-full bg-[#25D366] text-white shadow-xl shadow-black/25 transition hover:scale-105 pb-[env(safe-area-inset-bottom)] sm:bottom-6 sm:right-6">
      <svg viewBox="0 0 32 32" class="h-7 w-7" fill="currentColor" aria-hidden="true"><path d="M19.1 17.3c-.3-.1-1.7-.8-1.9-.9s-.5-.1-.7.1-.8.9-.9 1.1-.3.2-.6.1a7.6 7.6 0 0 1-3.8-3.3c-.3-.5.3-.5.8-1.5.1-.2 0-.4 0-.5l-.9-2.1c-.2-.6-.5-.5-.7-.5h-.6a1.2 1.2 0 0 0-.9.4 3.700 3.700 0 0 0-1.100 2.700 6.400 6.400 0 0 0 1.300 3.400 14.600 14.600 0 0 0 5.600 4.900c2.100.9 2.900 1 3.900.8a3.300 3.300 0 0 0 2.200-1.600 2.700 2.700 0 0 0 .2-1.600c-.1-.1-.3-.2-.6-.4ZM16 3A13 13 0 0 0 4.800 22.500L3 29l6.700-1.700A13 13 0 1 0 16 3Zm0 23.700a10.600 10.600 0 0 1-5.400-1.500l-.4-.2-4 1 1.100-3.900-.3-.4A10.700 10.700 0 1 1 16 26.700Z"/></svg>
    </a>
    <script>
      // Parallax leve (transform via CSS var) + reveal on scroll. Respeita prefers-reduced-motion.
      function init() {
        const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
        const els = [...document.querySelectorAll<HTMLElement>('[data-parallax]')];
        if (!reduce && els.length) {
          const visible = new Set<HTMLElement>();
          const io = new IntersectionObserver((es) => es.forEach((e) => (e.isIntersecting ? visible.add(e.target as HTMLElement) : visible.delete(e.target as HTMLElement))), { rootMargin: '20% 0px' });
          els.forEach((el) => io.observe(el));
          let ticking = false;
          const update = () => {
            ticking = false;
            const vh = innerHeight;
            visible.forEach((el) => {
              const host = el.parentElement!.getBoundingClientRect();
              const speed = parseFloat(el.dataset.parallax || '0.2');
              const center = host.top + host.height / 2 - vh / 2;
              el.style.setProperty('--py', `${(-center * speed).toFixed(1)}px`);
              if (el.hasAttribute('data-parallax-zoom')) el.style.setProperty('--ps', String(1 + Math.min(Math.abs(center) / vh, 1) * 0.06));
            });
          };
          addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
          addEventListener('resize', update, { passive: true });
          update();
        }
        const rv = [...document.querySelectorAll<HTMLElement>('.reveal:not(.in)')];
        if (rv.length) {
          const io2 = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io2.unobserve(e.target); } }), { threshold: 0.12, rootMargin: '0px 0px -5% 0px' });
          rv.forEach((el) => io2.observe(el));
        }
      }
      init();
    </script>
  </body>
</html>
