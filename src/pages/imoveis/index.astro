---
import Base from '../../layouts/Base.astro';
import Listing from '../../components/Listing.astro';
import { getImoveis, available } from '../../lib/api';
import { SITE } from '../../lib/site';
const items = available(await getImoveis()).sort((a, b) => b.destaque - a.destaque || b.id - a.id);
const schema = [
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Início', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'Imóveis', item: SITE.url + '/imoveis' } ] },
  { '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'Imóveis à venda e para alugar', url: SITE.url + '/imoveis' },
];
---
<Base title={`Imóveis à venda em Rolante, Riozinho e Taquara | ${SITE.name}`} description={`Veja ${items.length} imóveis disponíveis: casas, terrenos, sítios e apartamentos em Rolante, Riozinho, Taquara e região. Filtre por preço, tipo e cidade e fale direto no WhatsApp.`} schema={schema}>
  <section class="bg-forest pb-10 pt-28 text-white sm:pt-36">
    <div class="container-x">
      <nav aria-label="Breadcrumb" class="text-sm text-white/60"><a href="/" class="hover:text-white">Início</a> / Imóveis</nav>
      <h1 class="mt-3 text-4xl font-semibold sm:text-5xl">Imóveis à venda e para alugar</h1>
      <p class="mt-3 max-w-2xl text-white/75">Casas, terrenos, sítios e apartamentos em Rolante, Riozinho, Taquara e região.</p>
    </div>
  </section>
  <section class="container-x pb-20 pt-6"><Listing items={items} /></section>
</Base>
