---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { SITE, wa } from '../lib/site';
---
<Base title={`Contato | ${SITE.name} — Rolante, RS`} description={`Fale com a Alves Negócios Imobiliários pelo WhatsApp ${SITE.phone} ou e-mail. Atendimento em Rolante, Riozinho, Taquara e região.`}>
  <section class="bg-forest pb-14 pt-28 text-white sm:pt-36"><div class="container-x"><h1 class="text-4xl font-semibold sm:text-6xl">Vamos conversar?</h1><p class="mt-3 max-w-xl text-white/75">Escolha o canal que preferir. Respondemos rapidinho.</p></div></section>
  <section class="container-x grid gap-4 py-12 sm:grid-cols-2 lg:grid-cols-3">
    <a href={wa('Olá!')} target="_blank" rel="noopener" class="rounded-3xl bg-white p-6 ring-1 ring-black/5 transition hover:shadow-lg"><span class="grid h-12 w-12 place-items-center rounded-2xl bg-[#25D366] text-white"><Icon name="phone" /></span><p class="mt-4 font-display text-xl font-semibold">Mari · WhatsApp</p><p class="text-stone-600">{SITE.phone}</p></a>
    <a href={wa('Olá!', '5551998849654')} target="_blank" rel="noopener" class="rounded-3xl bg-white p-6 ring-1 ring-black/5 transition hover:shadow-lg"><span class="grid h-12 w-12 place-items-center rounded-2xl bg-[#25D366] text-white"><Icon name="phone" /></span><p class="mt-4 font-display text-xl font-semibold">Renato · WhatsApp</p><p class="text-stone-600">{SITE.phone2}</p></a>
    <a href={`mailto:${SITE.email}`} class="rounded-3xl bg-white p-6 ring-1 ring-black/5 transition hover:shadow-lg"><span class="grid h-12 w-12 place-items-center rounded-2xl bg-brand-100 text-brand-700"><Icon name="mail" /></span><p class="mt-4 font-display text-xl font-semibold">E-mail</p><p class="break-all text-stone-600">{SITE.email}</p></a>
    <a href={SITE.instagram} target="_blank" rel="noopener" class="rounded-3xl bg-white p-6 ring-1 ring-black/5 transition hover:shadow-lg"><span class="grid h-12 w-12 place-items-center rounded-2xl bg-brand-100 text-brand-700"><Icon name="insta" /></span><p class="mt-4 font-display text-xl font-semibold">Instagram</p><p class="text-stone-600">@marialves_corretora</p></a>
    <div class="rounded-3xl bg-white p-6 ring-1 ring-black/5"><span class="grid h-12 w-12 place-items-center rounded-2xl bg-brand-100 text-brand-700"><Icon name="clock" /></span><p class="mt-4 font-display text-xl font-semibold">Horário</p><p class="text-stone-600">Seg a Sex: 9h às 18h<br />Sáb: 9h às 13h</p></div>
  </section>
</Base>
