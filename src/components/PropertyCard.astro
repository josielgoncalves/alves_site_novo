---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { propertyTitle, type Imovel } from '../lib/api';
const { p, eager = false } = Astro.props as { p: Imovel; eager?: boolean };
const num = (v?: string | null) => (v && v !== '0' ? v : null);
---
<article class="group overflow-hidden rounded-3xl bg-white shadow-sm ring-1 ring-black/5 transition hover:-translate-y-1 hover:shadow-xl"
  data-card data-city={p.citySlug} data-type={p.typeSlug} data-price={p.priceNum} data-beds={p.quartos} data-rent={p.isRent ? '1' : '0'} data-q={`${p.titulo} ${p.bairro ?? ''} ${p.codigo} ${p.cidade}`.toLowerCase()}>
  <a href={`/imovel/${p.id}`} class="block" aria-label={propertyTitle(p)}>
    <div class="relative aspect-[4/3] overflow-hidden bg-stone-200">
      <Image src={p.images[0]} alt={`${propertyTitle(p)} — ${p.titulo}`} width={640} height={480} widths={[360, 560, 720]} sizes="(min-width:1024px) 380px, (min-width:640px) 45vw, 92vw" quality={70} format="webp" loading={eager ? 'eager' : 'lazy'} decoding="async" class="h-full w-full object-cover transition duration-700 group-hover:scale-105" />
      <div class="absolute left-3 top-3 flex gap-2">
        <span class="rounded-full bg-white/95 px-3 py-1 text-xs font-bold uppercase tracking-wide text-brand-800 shadow">{p.isRent ? 'Aluguel' : 'Venda'}</span>
        {p.destaque ? <span class="rounded-full bg-amber-400 px-3 py-1 text-xs font-bold uppercase tracking-wide text-amber-950 shadow">Destaque</span> : null}
        {p.sold ? <span class="rounded-full bg-stone-900 px-3 py-1 text-xs font-bold uppercase tracking-wide text-white shadow">Vendido</span> : null}
      </div>
    </div>
    <div class="p-5">
      <p class="flex items-center gap-1 text-[13px] font-medium text-brand-700"><Icon name="pin" class="h-4 w-4" />{p.bairro ? `${p.bairro} · ` : ''}{p.cityLabel}</p>
      <h3 class="mt-1.5 line-clamp-2 min-h-[3.2rem] font-display text-xl font-semibold leading-snug text-stone-900">{p.titulo}</h3>
      <p class="mt-3 text-2xl font-bold text-brand-700">{p.priceLabel}</p>
      <ul class="mt-4 flex flex-wrap gap-x-4 gap-y-2 border-t border-stone-100 pt-4 text-sm text-stone-600">
        {p.quartos > 0 && <li class="flex items-center gap-1.5"><Icon name="bed" class="h-4 w-4 text-brand-600" />{p.quartos}</li>}
        {p.banheiros > 0 && <li class="flex items-center gap-1.5"><Icon name="bath" class="h-4 w-4 text-brand-600" />{p.banheiros}</li>}
        {p.vagas > 0 && <li class="flex items-center gap-1.5"><Icon name="car" class="h-4 w-4 text-brand-600" />{p.vagas}</li>}
        {num(p.area_total) && <li class="flex items-center gap-1.5"><Icon name="ruler" class="h-4 w-4 text-brand-600" />{p.area_total}</li>}
      </ul>
    </div>
  </a>
</article>
